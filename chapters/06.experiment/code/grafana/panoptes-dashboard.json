{
  "title": "PANOPTES Unified Observability",
  "tags": ["panoptes", "k8s", "otel"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Application RED Metrics (Prometheus)",
      "type": "timeseries",
      "datasource": "prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{}[5m])) by (le, service))",
          "legendFormat": "{{service}} - p95 Latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Distributed Tracing (Tempo)",
      "type": "traces",
      "datasource": "tempo",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ duration > 1500ms }"
        }
      ]
    },
    {
      "title": "Contextual Logs (Loki)",
      "type": "logs",
      "datasource": "loki",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "{namespace=\"otel-demo\"} |= `error`"
        }
      ]
    }
  ]
}